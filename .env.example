# GovStart AI - Environment Configuration Example
# The application automatically runs in Zero-Config Demo Mode if variables are omitted.

# 1. Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/govstart_ai?schema=public"

# 2. Authentication (Auth.js / NextAuth)
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# 3. AI Inference Service (OpenAI API)
# If OPENAI_API_KEY is not set, GovStart AI uses grounded sovereign NLP heuristics & local microservice
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# 4. Optional Local AI Microservice URL (FastAPI)
AI_SERVICE_URL="http://localhost:8000"

# 5. Application Mode
NEXT_PUBLIC_DEMO_MODE="true"
